{
  "name": "qixu-desktop",
  "productName": "栖序",
  "version": "1.7.6",
  "private": true,
  "description": "栖序：今日有序，片刻从容。Windows 上的待办、阅读与影音空间。",
  "author": "Qixu",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "node scripts/prepare-native.cjs && tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@tanstack/react-virtual": "^3.13.12",
    "@xmldom/xmldom": "0.9.12",
    "epubjs": "^0.3.93",
    "franc-min": "6.2.0",
    "iconv-lite": "^0.7.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.moyu.desktop",
    "productName": "栖序",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.*",
      "assets/fullscreen-controls.*",
      "package.json",
      "THIRD_PARTY_NOTICES.txt"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Qixu-Setup-${version}-${arch}.${ext}",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "include": "assets/qixu-installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "栖序",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "native",
        "to": "native",
        "filter": [
          "TodoHost.exe",
          "icon.ico"
        ]
      },
      {
        "from": "models",
        "to": "models"
      }
    ]
  },
  "overrides": {
    "@xmldom/xmldom": "$@xmldom/xmldom"
  }
}
